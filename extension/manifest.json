{
  "manifest_version": 3,
  "name": "Mugibot",
  "version": "1.0.1",
  "description": "⚡ Buy from your Mugibot watchlist or Discord ping: sets quantity, adds to bag, fills in checkout and stops at the final button for you to press.",
  "permissions": ["storage", "alarms"],
  "host_permissions": [],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "Mugibot", "default_popup": "popup.html", "default_icon": { "16": "icon16.png", "48": "icon48.png", "128": "icon128.png" } },
  "options_page": "options.html",
  "icons": { "16": "icon16.png", "48": "icon48.png", "128": "icon128.png" },
  "content_scripts": []
}
