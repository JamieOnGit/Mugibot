{
  "manifest_version": 3,
  "name": "Mugibot",
  "version": "1.30.0",
  "description": "⚡ Buy from your Mugibot watchlist or Discord ping: straight to checkout with it in your bag, filled in up to the final button.",
  "permissions": ["storage", "alarms", "scripting"],
  "host_permissions": [],
  "optional_host_permissions": ["https://*/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "Mugibot", "default_popup": "popup.html", "default_icon": { "16": "icon16.png", "48": "icon48.png", "128": "icon128.png" } },
  "options_page": "options.html",
  "icons": { "16": "icon16.png", "48": "icon48.png", "128": "icon128.png" },
  "content_scripts": []
}
