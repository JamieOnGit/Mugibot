# Copy to .env for running on your own computer (npm start / npm run demo read it).
# On Fly.io / Render, set these as secrets / environment variables instead.
# Every setting is explained in docs/SETUP.md.

# --- Required in production ----------------------------------------------------
# The public address people use (https://… in production). Used in links,
# Discord buttons and the Whop checkout, and built into the browser extension.
BASE_URL=http://localhost:8080
# Encrypts everyone's saved details. 32 random bytes: `openssl rand -hex 32`.
# BACK IT UP. If it's lost or changed, saved delivery details can't be read.
DATA_ENCRYPTION_KEY=
# These usernames are admins when they sign up / log in (comma-separated).
ADMIN_USERNAMES=jamie

# --- Server --------------------------------------------------------------------
PORT=8080
# DATABASE_PATH=./data/mugibot.db
# Set to 1 behind a proxy/load balancer (Fly, Render) so rate limits see real IPs.
# TRUST_PROXY=1
# Other addresses that serve the same app (e.g. your fly.dev address as well as your domain).
# EXTRA_ORIGINS=https://mugibot.fly.dev

# --- Your business -------------------------------------------------------------
APP_NAME=Mugibot
SUPPORT_EMAIL=support@example.com
PRICE_DISPLAY=A$19.99 / month
# Free trial days for new accounts (0 = none: people become members through Whop).
TRIAL_DAYS=0
# SIGNUPS_OPEN=1
# Once the extension is on the Chrome Web Store, link it here (or paste the link
# in Admin → Setup check, which wins). docs/CHROME-WEB-STORE.md:
# CHROME_STORE_URL=https://chromewebstore.google.com/detail/…

# --- Whop (memberships) — docs/WHOP.md -------------------------------------------
# Account API key (Whop dashboard → Developer → API keys).
WHOP_API_KEY=
# The plan_… of your A$19.99/month pricing option.
WHOP_PLAN_ID=
# The prod_… of your Mugibot product (accepts every plan of it, e.g. monthly and yearly).
WHOP_PRODUCT_ID=
# Signing secret of the webhook pointing at https://<BASE_URL>/api/whop/webhook (starts with ws_).
WHOP_WEBHOOK_SECRET=
# Optional: your product's public Whop page, used only while WHOP_API_KEY isn't set.
# WHOP_CHECKOUT_URL=https://whop.com/your-store/mugibot/
# WHOP_API_BASE=https://api.whop.com/api/v1

# --- Discord — docs/DISCORD.md -----------------------------------------------------
# Developer Portal → your application → General Information / OAuth2 / Bot.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=
# Right-click → Copy ID (turn on Developer Mode in Discord first).
DISCORD_GUILD_ID=
DISCORD_MEMBER_ROLE_ID=
DISCORD_RESTOCK_CHANNEL_ID=
# Optional: a role to @mention in restock posts (make it mentionable).
DISCORD_RESTOCK_ROLE_ID=
# Optional: shown to members on their Discord tab.
# DISCORD_INVITE_URL=https://discord.gg/…
# 1 = remove people from the server when their membership ends (default: just take the role away).
# DISCORD_KICK_ON_EXPIRE=0

# --- Email (optional, Resend) ---------------------------------------------------------
# Password resets and email alerts. Without it, resets go by Discord DM or an admin's reset link.
RESEND_API_KEY=
EMAIL_FROM=Mugibot <alerts@mugibot.com>

# --- Limits ------------------------------------------------------------------------------
# MAX_ITEMS=50
# MAX_PROFILES=5
# MAX_DEVICES=5
# SIGNUPS_PER_HOUR=10
# SESSION_DAYS=30

# --- Restock monitor ------------------------------------------------------------------------
# MONITOR_ENABLED=1
# Seconds between server checks of one page (however many people watch it).
# MONITOR_URL_INTERVAL=60
# Seconds between any two server requests to the same store.
# MONITOR_HOST_GAP=5
# Seconds between a member's own browser re-checking one of their SKUs (stores that refuse servers).
# BROWSER_CHECK_INTERVAL=60
# Server checks only fetch public web addresses. Set to 1 ONLY to test with a store on your own computer.
# MONITOR_ALLOW_PRIVATE=0
# The Monitor feed (docs/MONITORING.md): the shortest interval a monitor may ask for (seconds),
# the cooldown before a product alerts the same kind again (seconds), the smallest price change
# that alerts (percent), and how many days the check log is kept.
# MONITOR_MIN_INTERVAL=20
# MONITOR_ALERT_COOLDOWN=600
# MONITOR_PRICE_CHANGE_PERCENT=1
# MONITOR_LOG_DAYS=7
# A store's budget for what each browser reads of it (BIG W's: docs/MONITORING.md), changed without a release:
# MONITOR_ACCESS={"bigw":{"gapSeconds":12}}

# --- Dummy store (testing) ---------------------------------------------------------------------
# npm run demo sets this for you. Point it at the dummy store (npm run mockstore) to test every flow.
# DEMO_STORE_URL=http://localhost:5055
